# Normalise to LF in the repository and in the working tree. Without the
# working-tree half, Git for Windows checks files out as CRLF, and the shell
# scripts under war-infra/scripts/ would break on the Linux runners.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
