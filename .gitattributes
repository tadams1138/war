# Normalise to LF in the repository and in the working tree.
#
# Without this, Git for Windows checks files out as CRLF while storing LF,
# which makes every checked-out file differ from its blob. The Fire Team
# preflight checks for LF endings and repairs what it can; pinning the working
# tree to LF here means it has nothing to repair, and the shell scripts under
# war-infra/scripts/ stay executable on the Linux runners that run them.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
