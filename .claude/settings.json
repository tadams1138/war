{
  "extraKnownMarketplaces": {
    "tadams-plugins": {
      "source": {
        "source": "github",
        "repo": "tadams1138/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "todo@tadams-plugins": true,
    "google-oauth@tadams-plugins": true,
    "microsoft-oauth@tadams-plugins": true,
    "twitter-x-oauth@tadams-plugins": true,
    "facebook-oauth@tadams-plugins": true,
    "digitalocean-app-platform@tadams-plugins": true,
    "cloudflare-terraform@tadams-plugins": true,
    "typescript-lsp@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "terraform@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Read(**/.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(npm install*)",
      "Bash(apt*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(npm --prefix war-api ci:*)",
      "Bash(npm --prefix war-api run:*)",
      "Bash(npm --prefix war-api test:*)",
      "Bash(npm --prefix war-ui-default ci:*)",
      "Bash(npm --prefix war-ui-default run:*)",
      "Bash(npm --prefix war-ui-default test:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform -chdir=war-infra/terraform/envs/staging:*)",
      "Bash(terraform -chdir=war-infra/terraform/envs/production:*)",
      "Bash(terraform -chdir=war-infra/terraform/shared:*)",
      "Bash(ls*)",
      "Bash(cat*)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
