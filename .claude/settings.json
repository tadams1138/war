{
  "permissions": {
    "deny": [
      "Bash(git push*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Read(**/.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(npm install*)",
      "Bash(apt*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(npm --prefix war-api ci:*)",
      "Bash(npm --prefix war-api run:*)",
      "Bash(npm --prefix war-api test:*)",
      "Bash(npm --prefix war-ui-default ci:*)",
      "Bash(npm --prefix war-ui-default run:*)",
      "Bash(npm --prefix war-ui-default test:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform -chdir=war-infra/terraform/envs/staging:*)",
      "Bash(terraform -chdir=war-infra/terraform/envs/production:*)",
      "Bash(terraform -chdir=war-infra/terraform/shared:*)",
      "Bash(ls*)",
      "Bash(cat*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "attribution": {
    "commits": false,
    "pullRequests": false
  }
}
